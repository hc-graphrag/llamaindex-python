# syntax=docker/dockerfile:1
FROM rust:1.90-bookworm AS builder

ARG ALOPEX_VERSION=0.8.16
RUN cargo install --locked --version "${ALOPEX_VERSION}" alopex-server

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --home /var/lib/alopex --shell /usr/sbin/nologin alopex \
    && install -d -o alopex -g alopex /var/lib/alopex /etc/alopex

COPY --from=builder /usr/local/cargo/bin/alopex-server /usr/local/bin/alopex-server
COPY docker/alopex-server.toml /etc/alopex/alopex.toml

USER alopex
EXPOSE 8080 9090
VOLUME ["/var/lib/alopex"]

HEALTHCHECK --interval=5s --timeout=3s --retries=12 --start-period=10s \
    CMD curl --fail --silent http://127.0.0.1:8081/healthz >/dev/null || exit 1

ENTRYPOINT ["alopex-server"]
CMD ["--config", "/etc/alopex/alopex.toml"]
